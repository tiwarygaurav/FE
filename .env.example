# Copy to .env and fill in the portal login from the assignment brief.
# (Credentials are deliberately not committed to the repository.)
URJA_PORTAL_EMAIL=
URJA_PORTAL_PASSWORD=

# Everything below is optional; the values shown are the defaults.
# URJA_PORTAL_BASE_URL=https://urja-ops.flockenergy.tech
# URJA_PORTAL_TIMEOUT_S=10                # one HTTP request to the portal
# URJA_PORTAL_RATE_LIMIT_PER_MINUTE=100   # the portal allows ~120/min across all /portal/* calls
# URJA_PORTAL_RATE_LIMIT_BURST=10
# URJA_PORTAL_MAX_WAIT_S=25               # longest one portal call may take (3 s when a cached copy exists)
# URJA_DB_PATH=data/urja.sqlite3
# URJA_SYNC_INTERVAL_S=900                # reference data refresh
# URJA_READINGS_TTL_S=900                 # per-meter readings cache freshness
# URJA_WARM_READINGS=true                 # prefetch all meters' readings in the background (~4 min a pass)
# URJA_WARM_INTERVAL_S=3600               # ...and repeat that pass this often
# If set (printable ASCII, no spaces), every /v1/* request must send it as the X-API-Key header.
# URJA_API_KEY=
